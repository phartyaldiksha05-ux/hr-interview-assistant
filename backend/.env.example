ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://hr_user:hr_password@localhost:5433/hr_assistant
CORS_ORIGINS=http://localhost:5173
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
UPLOAD_DIR=uploads
REMINDER_POLL_SECONDS=60
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Meetwise AI HR Interview Assistant
SMTP_USE_TLS=true

# Email OTP
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
# Web Push / VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:your-email@example.com
